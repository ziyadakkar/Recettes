rules_version = '2';

// Qui peut lire et modifier les recettes.
// À copier dans la console Firebase → Firestore Database → Règles → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Les personnes qui utilisent l'app : lecture ET écriture.
    function estMembre() {
      return request.auth != null
        && request.auth.token.email in [
          'ziyadakkar@gmail.com',
          'EMAIL_DE_CHARLOTTE@gmail.com'
        ];
    }

    // Le compte utilisé par le script de sauvegarde Google : lecture SEULEMENT.
    function estSauvegarde() {
      return request.auth != null
        && request.auth.token.email == 'ziyadakkar+sauvegarde@gmail.com';
    }

    match /recipes/{recipeId} {
      allow read: if estMembre() || estSauvegarde();
      allow write: if estMembre();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
